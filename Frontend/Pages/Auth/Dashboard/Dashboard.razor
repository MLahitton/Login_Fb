@page "/dashboard"

@using Frontend.Models.Auth
@using Frontend.Services.Auth

@inject AuthApiService AuthService
@inject NavigationManager Navigation

<div class="dashboard-container">
    <div class="main-content" style="max-width: 900px; margin: 30px auto;">
        <div class="topbar">
            <div>
                <h1>Dashboard protegido</h1>
                <p>Esta pagina consulta el endpoint /api/auth/me con JWT.</p>
            </div>
        </div>

        @if (isLoading)
        {
            <p>Cargando usuario autenticado...</p>
        }
        else if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <p>@statusMessage</p>
        }

        @if (currentUser is not null)
        {
            <div class="cards" style="margin-top: 20px;">
                <div class="card">
                    <span>ID</span>
                    <h2 style="font-size: 1rem;">@currentUser.Id</h2>
                </div>

                <div class="card">
                    <span>Nombre</span>
                    <h2 style="font-size: 1rem;">@currentUser.FullName</h2>
                </div>

                <div class="card">
                    <span>Email</span>
                    <h2 style="font-size: 1rem;">@currentUser.Email</h2>
                </div>

                <div class="card">
                    <span>Confirmado</span>
                    <h2 style="font-size: 1rem;">@(currentUser.EmailConfirmed ? "Si" : "No")</h2>
                </div>
            </div>

            <button class="logout-button" style="margin-top: 30px;" @onclick="HandleLogout">
                Cerrar sesion
            </button>
        }
    </div>
</div>

@code {
    private UserResponse? currentUser;
    private string statusMessage = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticated())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var response = await AuthService.GetMe();
        isLoading = false;

        if (response.Success)
        {
            currentUser = response.Data;
            return;
        }

        statusMessage = response.Message;
        Navigation.NavigateTo("/login");
    }

    private async Task HandleLogout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login");
    }
}

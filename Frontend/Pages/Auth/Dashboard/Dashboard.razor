@page "/dashboard"

@using Frontend.Models.Dashboard
@using Frontend.Services.Auth

@inject AuthApiService AuthService


<div class="dashboard-container">

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div>

            <div class="logo">

                <img src="/img/primari.png" />

                <h2>NEXO</h2>

            </div>

            <ul class="menu">

                <li class="active">
                    Dashboard
                </li>

                <li>
                    Proyectos
                </li>

                <li>
                    Tareas
                </li>

                <li>
                    Clientes
                </li>

                <li>
                    Reportes
                </li>

                <li>
                    Configuración
                </li>

            </ul>

        </div>

        <button class="logout-button">
            Cerrar sesión
        </button>

    </div>

    <!-- MAIN -->

    <div class="main-content">

        <!-- TOPBAR -->

        <div class="topbar">

            <div>

                <h1>
                    Dashboard
                </h1>

                <p>
                    Bienvenido nuevamente 👋
                </p>

            </div>

            <div class="profile">

                <img src="https://i.pravatar.cc/100" />

                <div>

                    <h4>
                        Sergio Mendoza
                    </h4>

                    <span>
                        Administrador
                    </span>

                </div>

            </div>

        </div>

        <!-- STATS -->

        <div class="cards">

            <div class="card">

                <span>
                    Proyectos Activos
                </span>

                <h2>
                    @stats.ActiveProjects
                </h2>

            </div>

            <div class="card">

                <span>
                    Tareas Pendientes
                </span>

                <h2>
                    @stats.PendingTasks
                </h2>

            </div>

            <div class="card">

                <span>
                    Clientes Activos
                </span>

                <h2>
                    @stats.ActiveClients
                </h2>

            </div>

            <div class="card">

                <span>
                    Ingresos
                </span>

                <h2>
                    $@stats.Revenue
                </h2>

            </div>

        </div>

        <!-- CONTENT -->

        <div class="content">

            <!-- ACTIVITIES -->

            <div class="activities">

                <div class="section-title">

                    <h3>
                        Actividad reciente
                    </h3>

                </div>

                @foreach (var item in activities)
                {
                    <div class="activity-item">

                        <h4>
                            @item.Title
                        </h4>

                        <p>
                            @item.Description
                        </p>

                    </div>
                }

            </div>

            <!-- QUICK ACTIONS -->

            <div class="actions">

                <div class="section-title">

                    <h3>
                        Acciones rápidas
                    </h3>

                </div>

                @foreach (var action in actions)
                {
                    <button class="action-button">

                        @action.Name

                    </button>
                }

            </div>

        </div>

    </div>

</div>

@code {

    DashboardStats stats = new();

    List<ActivityItem> activities = new();

    List<QuickAction> actions = new();

    protected override async Task OnInitializedAsync()
    {
        stats = await AuthService.GetStats();

        activities = await AuthService.GetActivities();

        actions = await AuthService.GetQuickActions();
    }
}
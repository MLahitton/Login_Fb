@page "/forgot-password"

@using Frontend.Models.Auth
@using Frontend.Services.Auth

@inject AuthApiService AuthService
@inject NavigationManager Navigation

<div class="forgot-container">

    <div class="forgot-card">

        <div class="logo">
            Nexo
        </div>

        <div class="icon-circle">
            🔒
        </div>

        <h2>¿Olvidaste tu contraseña?</h2>

        <p>
            Ingresa tu correo electrónico y te enviaremos
            un enlace para restablecerla.
        </p>

        <EditForm Model="model" OnValidSubmit="HandleForgotPassword">

            <DataAnnotationsValidator />

            <div class="form-group">

                <label>Correo electrónico</label>

                <InputText class="form-control"
                           @bind-Value="model.Email" />

                <ValidationMessage For="@(() => model.Email)" />

            </div>

            <button class="register-button" type="submit">
                Enviar enlace de recuperación
            </button>

        </EditForm>

        <div class="back-login">
            <a href="/login">
                Volver al inicio de sesión
            </a>
        </div>

    </div>

</div>

@code {

    ForgotPasswordRequest model = new();

    async Task HandleForgotPassword()
    {
        await AuthService.ForgotPassword(model);

        Navigation.NavigateTo("/reset-password");
    }
}
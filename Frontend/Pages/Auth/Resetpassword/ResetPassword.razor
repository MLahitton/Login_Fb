@page "/reset-password"

@using Frontend.Models.Auth
@using Frontend.Services.Auth

@inject AuthApiService AuthService

<div class="forgot-container">

    <div class="forgot-card">

        <div class="logo">
            Nexo
        </div>

        <div class="icon-circle">
            🔑
        </div>

        <h2>Restablece tu contraseña</h2>

        <p>
            Crea una nueva contraseña segura para tu cuenta.
        </p>

        <EditForm Model="model" OnValidSubmit="HandleResetPassword">

            <DataAnnotationsValidator />

            <div class="form-group">

                <label>Nueva contraseña</label>

                <InputText type="password"
                           class="form-control"
                           @bind-Value="model.NewPassword" />

            </div>

            <div class="form-group">

                <label>Confirmar nueva contraseña</label>

                <InputText type="password"
                           class="form-control"
                           @bind-Value="model.ConfirmPassword" />

            </div>

            <button class="register-button" type="submit">
                Actualizar contraseña
            </button>

        </EditForm>

        <div class="back-login">
            <a href="/login">
                Volver al inicio de sesión
            </a>
        </div>

    </div>

</div>

@code {

    ResetPasswordRequest model = new();

    async Task HandleResetPassword()
    {
        await AuthService.ResetPassword(model);

        Console.WriteLine("Password actualizado");
    }
}
@using Frontend.Models.Auth
@using Frontend.Services.Auth

@page "/login"
@inject AuthApiService AuthService
@inject NavigationManager Navigation

<div class="register-container">
    <div class="left-panel">
        <img src="/img/candadito.png" class="illustration" />
        <h3>Tu seguridad es nuestra prioridad</h3>
        <p>Usamos cifrado en todas tus conexiones.</p>
    </div>

    <div class="right-panel">
        <h1>Bienvenido de vuelta</h1>
        <p>Ingresa para continuar a tu cuenta.</p>

        <EditForm Model="model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>Correo electronico</label>
                <InputText class="form-control" @bind-Value="model.Email" />
                <ValidationMessage For="@(() => model.Email)" />
            </div>

            <div class="form-group">
                <label>Contrasena</label>
                <InputText type="password" class="form-control" @bind-Value="model.Password" />
                <ValidationMessage For="@(() => model.Password)" />
            </div>

            <p class="forgot-password">
                <a href="/forgot-password">Olvidaste tu contrasena?</a>
            </p>

            <button class="register-button" type="submit" disabled="@isLoading">
                @(isLoading ? "Ingresando..." : "Iniciar sesion")
            </button>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <p style="margin-top: 15px;">@statusMessage</p>
        }

        <p style="margin-top:15px;">
            No tienes una cuenta?
            <a href="/register">Registrate</a>
        </p>
    </div>
</div>

@code {
    private readonly LoginRequest model = new();
    private string statusMessage = string.Empty;
    private bool isLoading;

    private async Task HandleLogin()
    {
        isLoading = true;
        statusMessage = string.Empty;

        var response = await AuthService.Login(model);
        statusMessage = response.Message;
        isLoading = false;

        if (response.Success)
        {
            Navigation.NavigateTo("/dashboard");
        }
    }
}

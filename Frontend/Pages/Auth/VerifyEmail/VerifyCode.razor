@page "/verify-code"

@using Frontend.Models.Auth
@using Frontend.Services.Auth

@inject NavigationManager Navigation
@inject AuthApiService AuthService

<div class="verify-container">
    <div class="verify-card">
        <div class="icon-circle">Codigo</div>
        <h2>Confirma tu correo</h2>
        <p>Hemos enviado un codigo de verificacion a:</p>
        <strong>@(string.IsNullOrWhiteSpace(model.Email) ? "tu correo" : model.Email)</strong>

        <EditForm Model="model" OnValidSubmit="HandleVerify">
            <DataAnnotationsValidator />

            <div class="code-container">
                <InputText class="code-input" maxlength="6" @bind-Value="model.Code" />
                <ValidationMessage For="@(() => model.Code)" />
            </div>

            <button class="confirm-button" type="submit" disabled="@isLoading">
                @(isLoading ? "Verificando..." : "Confirmar codigo")
            </button>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <p style="margin-top: 15px;">@statusMessage</p>
        }

        <p style="margin-top:15px;">
            <a href="/register">Volver</a>
        </p>
    </div>
</div>

@code {
    private readonly VerifyCodeRequest model = new();
    private string statusMessage = string.Empty;
    private bool isLoading;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        model.Email = ReadQueryValue(uri.Query, "email");
    }

    private async Task HandleVerify()
    {
        isLoading = true;
        statusMessage = string.Empty;

        var response = await AuthService.VerifyCode(model);
        statusMessage = response.Message;
        isLoading = false;

        if (response.Success)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private static string ReadQueryValue(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return string.Empty;
        }

        var parts = query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);

        foreach (var part in parts)
        {
            var tokens = part.Split('=', 2);
            if (tokens.Length != 2)
            {
                continue;
            }

            if (string.Equals(tokens[0], key, StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(tokens[1]);
            }
        }

        return string.Empty;
    }
}
